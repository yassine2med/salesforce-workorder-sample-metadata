<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Due_Date_After_Request</fullName>
    <active>true</active>
    <description>The due date cannot be before the request date.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Due_Date__c)), Due_Date__c &lt; Requested_On__c)</errorConditionFormula>
    <errorDisplayField>Due_Date__c</errorDisplayField>
    <errorMessage>Due Date cannot be before the Requested On date.</errorMessage>
</ValidationRule>
